# ---------------------------------------------------------------------------
# Manus / Forge storage proxy (required for the /manus-storage/ images to load)
#
# The portfolio references artwork through /manus-storage/<key> URLs. Those
# files are not checked into the repo; this proxy resolves them from the
# external storage backend. Set both values in the deployment/runtime env.
# ---------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Hero background video (optional)
#
# If set, the hero visual renders a looping <video> with this source. If unset,
# the bundled /manus-storage/hero-ambient.mp4 (with .webm fallback) is used.
# The ambient texture image is used as the poster, and the existing
# reduced-motion / low-data rules keep it hidden when motion is paused.
# ---------------------------------------------------------------------------
VITE_HERO_VIDEO_URL=
